# ── Required: from https://discord.com/developers/applications ──
DISCORD_TOKEN=paste-your-bot-token-here
CLIENT_ID=paste-your-application-id-here
# Your server's ID: commands show up there instantly. Leave blank for global (takes up to an hour).
GUILD_ID=

# ── Optional: AI-written prose. Leave blank to use the free built-in engine. ──
# OpenRouter (https://openrouter.ai/keys): any model. Pick one at https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Or Claude directly (https://console.anthropic.com):
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ── Optional: the DM's spoken voice. Free Microsoft Edge voices are used by default (no key). ──
# For movie-quality voices, add an ElevenLabs key (https://elevenlabs.io) and optionally a voice ID.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ── Optional: where data is saved (default: ./data/db.json) ──
# DATA_FILE=
